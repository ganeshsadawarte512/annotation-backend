# Local dev default (SQLite, no setup needed):
DATABASE_URL=sqlite:///./annotation.db

# Production (swap in your Postgres instance, e.g. from Render/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/annotation

# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local disk storage (default). Swap to "s3" once you move to R2/S3.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# Only used if STORAGE_BACKEND=s3 (e.g. Cloudflare R2)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
